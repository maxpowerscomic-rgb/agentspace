# wiwo — optional configuration

# ANTHROPIC_API_KEY: enables wiwo's own summarizer (turns diffs into log lines).
# Without it, wiwo falls back to commit-message summaries — the app still works.
ANTHROPIC_API_KEY="sk-ant-..."

# WIWO_MODEL: model for the summarizer (default: claude-opus-5). Any provider
# can be slotted in later behind the same interface.
WIWO_MODEL="claude-opus-5"

# PORT: server port (default 3000).
PORT="3000"

# --- Phase 3 options ---

# WIWO_PROVIDER: summarizer backend — anthropic | gemini | openai | none.
# Omit to auto-detect from whichever API key is present.
WIWO_PROVIDER="anthropic"

# GEMINI_API_KEY / OPENAI_API_KEY: alternatives to ANTHROPIC_API_KEY.
# OPENAI_BASE_URL: point the openai provider at any OpenAI-compatible endpoint.

# WIWO_POST_WEBHOOK: outgoing webhook for scheduled/manual posting. wiwo POSTs
# { platform, date, blocks, combined } here — wire it to Zapier/Make/n8n or your
# own poster. Without it, posting just marks the thread posted for manual paste.
WIWO_POST_WEBHOOK=""
