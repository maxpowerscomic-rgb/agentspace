# wiwo — optional configuration

# ANTHROPIC_API_KEY: enables wiwo's own summarizer (turns diffs into log lines).
# Without it, wiwo falls back to commit-message summaries — the app still works.
ANTHROPIC_API_KEY="sk-ant-..."

# WIWO_MODEL: model for the summarizer (default: claude-opus-5). Any provider
# can be slotted in later behind the same interface.
WIWO_MODEL="claude-opus-5"

# PORT: server port (default 3000).
PORT="3000"

# --- Phase 3 options ---

# WIWO_PROVIDER: summarizer backend — anthropic | gemini | openai | none.
# Omit to auto-detect from whichever API key is present.
WIWO_PROVIDER="anthropic"

# GEMINI_API_KEY / OPENAI_API_KEY: alternatives to ANTHROPIC_API_KEY.
# OPENAI_BASE_URL: point the openai provider at any OpenAI-compatible endpoint.

# WIWO_POST_WEBHOOK: outgoing webhook for scheduled/manual posting. wiwo POSTs
# { platform, date, blocks, combined } here — wire it to Zapier/Make/n8n or your
# own poster. Without it, posting just marks the thread posted for manual paste.
WIWO_POST_WEBHOOK=""

# --- Phase 4: live Claude Code session control ---

# Requires ANTHROPIC_API_KEY (above) and the optional SDK:
#   npm i @anthropic-ai/claude-agent-sdk
# With them, the dashboard prompt box drives the project's real Claude Code
# session. Without them, prompts are just recorded (graceful fallback).

# WIWO_PERMISSION_MODE: how the driven session handles approvals —
# acceptEdits (default) | dontAsk | bypassPermissions.
# Only use bypassPermissions if you understand it skips every approval prompt.
WIWO_PERMISSION_MODE="acceptEdits"

# --- Native posting: secrets + OAuth apps ---

# WIWO_SECRET_KEY: 32-byte key (hex or base64) to encrypt stored tokens. If
# unset, wiwo generates data/.key (0600) automatically.
WIWO_SECRET_KEY=""

# X (Twitter) OAuth 2.0 app — enables one-click Connect for X.
WIWO_X_CLIENT_ID=""
WIWO_X_CLIENT_SECRET=""

# LinkedIn OAuth 2.0 app — enables one-click Connect for LinkedIn.
WIWO_LI_CLIENT_ID=""
WIWO_LI_CLIENT_SECRET=""

# --- Bridge mode: use your Claude subscription instead of an API key ---
# Routes wiwo's AI through your local Claude Code CLI (which can use your Pro/Max
# login). Requires `claude` installed + `claude login`. See docs/bridge-mode.md.
# For YOUR OWN personal use only — not for hosting on others' behalf.
WIWO_AI_MODE=""            # set to "bridge" to enable
WIWO_CLAUDE_BIN=""         # optional path to the `claude` binary if not on PATH

# --- Native iOS (Capacitor) ---
# The server URL the iOS app points at (LAN IP or an HTTPS tunnel). See
# docs/ios-native.md.
WIWO_SERVER_URL=""
